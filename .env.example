# Copy to .env.local and provide values locally; never commit the filled file.
# Public browser configuration (protected by Supabase RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never add the NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# A stable, base64-encoded 32-byte key for encrypted Telegram settings.
BOT_ENCRYPTION_KEY=
